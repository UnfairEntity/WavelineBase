:root {
}

.menu-button {
    align-items: flex-start;
    align-self: flex-start;
    width: auto;
    font-size: 32px;
    position: relative;
    -unity-text-auto-size: best-fit 10px 100px;
    -unity-text-generator: advanced;
    aspect-ratio: auto;
    background-image: none;
    background-repeat: no-repeat no-repeat;
    -unity-slice-type: sliced;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-right-width: 4px;
    border-top-width: 4px;
    flex-basis: auto;
    flex-grow: 0;
    top: auto;
    margin-top: 8%;
    margin-right: 8%;
    margin-bottom: 8%;
    margin-left: 8%;
    padding-top: 0%;
    padding-right: 1%;
    padding-bottom: 0%;
    padding-left: 1%;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 0 0 0 rgb(255, 255, 255);
    height: 16%;
    -unity-text-align: middle-right;
    white-space: nowrap;
    rotate: -10deg;
    transform-origin: left;
    transition-duration: 0.05s;
}

.menu-button:hover {
    translate: 0 0;
    scale: 1.2 1.2;
    transition-duration: 0.05s;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.menu-button:active {
    align-items: flex-start;
    align-self: flex-start;
    width: auto;
    font-size: 32px;
    position: relative;
    -unity-text-auto-size: best-fit 10px 100px;
    -unity-text-generator: advanced;
    aspect-ratio: auto;
    background-image: none;
    background-repeat: no-repeat no-repeat;
    -unity-slice-type: sliced;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-right-width: 4px;
    border-top-width: 4px;
    flex-basis: auto;
    flex-grow: 0;
    top: auto;
    margin-top: 5%;
    margin-right: 5%;
    margin-bottom: 5%;
    margin-left: 5%;
    padding-top: 0%;
    padding-right: 1%;
    padding-bottom: 0%;
    padding-left: 1%;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 0 0 0 rgb(255, 255, 255);
    height: 16%;
    -unity-text-align: middle-right;
    white-space: nowrap;
    rotate: -10deg;
    transform-origin: left;
    transition-duration: 0.05s;
}

.menu-background {
    position: absolute;
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    background-repeat: no-repeat no-repeat;
    background-size: 100% 100%;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0;
}

.menu-title {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 100px;
    position: absolute;
    right: 10%;
    bottom: 75%;
    left: 10%;
    top: 5%;
    -unity-font-definition: url("project://database/Assets/Menu/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=c51ed4ee338c1674aa24717acc9ccc3b&type=3#NotInter-Regular");
    color: rgb(255, 255, 255);
    font-size: 64px;
    -unity-text-align: upper-center;
}

.menu-button-panel {
    flex-grow: 1;
    right: 75%;
    left: 5%;
    top: 30%;
    width: auto;
    bottom: 5%;
    height: auto;
    min-width: auto;
    min-height: auto;
    position: absolute;
    justify-content: center;
}

.menu-panel {
    flex-grow: 1;
    position: absolute;
    top: 0%;
    left: 0%;
    right: 0%;
    bottom: 0%;
    opacity: 1;
    display: flex;
    visibility: visible;
}

.menu-subpanel {
    position: absolute;
    top: 30%;
    bottom: 5%;
    right: 5%;
    left: 30%;
    visibility: hidden;
}

.settings-entry {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    padding-right: 1%;
    padding-left: 1%;
    padding-bottom: 1%;
    padding-top: 1%;
    position: relative;
    right: 0%;
    left: 0%;
    top: auto;
    bottom: auto;
    height: 15%;
    margin-top: 1%;
    margin-right: 1%;
    margin-bottom: 1%;
    margin-left: 1%;
    rotate: 4deg;
    transform-origin: left;
}

.settings-entry-label {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    width: 50%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 100%;
    -unity-text-align: middle-left;
    -unity-text-auto-size: best-fit 10px 100px;
}

.settings-entry-sliderint {
    bottom: 0%;
    right: 0%;
    left: 50%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    width: 50%;
    min-height: auto;
    padding-top: 1%;
    padding-right: 1%;
    padding-bottom: 1%;
    padding-left: 1%;
    top: 0%;
    position: absolute;
}

.settings-entry-dropdown {
    bottom: 0%;
    right: 0%;
    left: 50%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    width: 50%;
    min-height: auto;
    padding-top: 1%;
    padding-right: 1%;
    padding-bottom: 1%;
    padding-left: 1%;
    top: 0%;
    position: absolute;
    -unity-text-auto-size: best-fit 10px 100px;
    -unity-font-definition: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    -unity-font-style: bold;
}
